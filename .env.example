# Sao chép thành .env (setup_wsl.sh tự làm). KHÔNG commit .env.
# Salt băm định danh — tạo: python -c "import secrets; print(secrets.token_hex(32))"
# MẤT SALT = không nối được dữ liệu mới với dữ liệu cũ. Sao lưu vào trình quản lý mật khẩu.
LIVESP_SALT=
# Tùy chọn: khóa dịch vụ ký của TikTokLive để nới giới hạn tần suất
TIKTOK_SIGN_API_KEY=
# Tùy chọn: baseline LLM qua Claude API
ANTHROPIC_API_KEY=
# Bộ nhớ đệm mô hình HuggingFace (để trong ổ Linux, không để ở /mnt/c)
HF_HOME=/home/YOUR_USER/.cache/huggingface
